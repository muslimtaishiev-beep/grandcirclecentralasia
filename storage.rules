rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSuperadmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/superadmins/$(request.auth.uid));
    }

    function isTenantUser(tenantId) {
      return request.auth != null &&
        ('tenantIds' in request.auth.token) &&
        (tenantId in request.auth.token.tenantIds);
    }

    // Proctoring session recordings.
    //
    // Write is open because the student sitting the exam is anonymous — there is
    // no Firebase Auth session to check, the same reason the exam endpoints run
    // through the Admin SDK. It is bounded instead of authorised: one fixed
    // filename per session, video/webm only, 500 MB ceiling. Nothing here is
    // readable without staff credentials, so an unauthenticated writer can at
    // worst overwrite their own recording — which they could do by simply
    // retaking the exam anyway.
    //
    // Read is deliberately NOT public: the student must never be handed their
    // own footage, and one tenant must never see another's. Only the owning
    // tenant's staff (or a superadmin) can play it back.
    match /proctoring/{tenantId}/{shortId}/{fileName} {
      allow read: if isSuperadmin() || isTenantUser(tenantId);
      allow create, update: if fileName == 'session.webm'
        && request.resource.size < 500 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
      allow delete: if isSuperadmin() || isTenantUser(tenantId);
    }

    // Everything else stays closed unless a rule above opens it.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

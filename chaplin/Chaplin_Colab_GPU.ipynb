      "source": [
        "# 👄 Chaplin VSR (Auto-AVSR 3D-CNN) - Google Colab GPU Server\n",
        "Запустите все ячейки по очереди для мгновенного запуска сервера распознавания губ с бесплатым GPU T4!"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 1. Клонируем проект и устанавливаем системные пакеты\n",
        "!git clone https://github.com/muslimtaishiev-beep/grandcirclecentralasia.git /content/app\n",
        "%cd /content/app/chaplin\n",
        "!apt-get update && apt-get install -y ffmpeg libsm6 libxext6 curl git\n",
        "!pip install -r requirements.txt uvicorn fastapi python-multipart pyngrok nest_asyncio pycloudflared"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 2. Скачиваем веса нейросетей Chaplin LRS3 Auto-AVSR\n",
        "!mkdir -p benchmarks/LRS3/language_models/lm_en_subword/ benchmarks/LRS3/models/LRS3_V_WER19.1/\n",
        "!curl -L https://huggingface.co/Amanvir/lm_en_subword/resolve/main/model.json -o benchmarks/LRS3/language_models/lm_en_subword/model.json\n",
        "!curl -L https://huggingface.co/Amanvir/lm_en_subword/resolve/main/model.pth -o benchmarks/LRS3/language_models/lm_en_subword/model.pth\n",
        "!curl -L https://huggingface.co/Amanvir/LRS3_V_WER19.1/resolve/main/model.json -o benchmarks/LRS3/models/LRS3_V_WER19.1/model.json\n",
        "!curl -L https://huggingface.co/Amanvir/LRS3_V_WER19.1/resolve/main/model.pth -o benchmarks/LRS3/models/LRS3_V_WER19.1/model.pth"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 3. Запускаем сервер FastAPI с бесплатным туннелем Cloudflare\n",
        "import subprocess\n",
        "import threading\n",
        "import time\n",
        "\n",
        "def start_server():\n",
        "    subprocess.run([\"python3\", \"chaplin_api.py\"])\n",
        "\n",
        "threading.Thread(target=start_server, daemon=True).start()\n",
        "time.sleep(5)\n",
        "\n",
        "# Создаем бесплатный публичный HTTPS туннель через pycloudflared\n",
        "from pycloudflared import try_cloudflare\n",
        "tunnel = try_cloudflare(port=8000)\n",
        "print(\"\\n=======================================================\")
        "print(f\"🚀 ВАШ БЕСПЛАТНЫЙ URL СЕРВЕРА CHAPLIN VSR (GPU T4):\")\n",
        "print(f\"{tunnel.tunnel_url}/api/vsr/decode\")\n",
        "print(\"=======================================================\\n\")"
      ]
    }
  ]
}

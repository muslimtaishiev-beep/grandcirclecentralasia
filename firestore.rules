rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // HELPER FUNCTIONS FOR MULTI-TENANT RLS & GROUP/USER RBAC
    // -------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'superadmin';
    }

    function isSameTenant(tenantId) {
      return isAuthenticated() && (
        request.auth.token.tenantId == tenantId || 
        (resource != null && resource.data.tenantId == tenantId) ||
        isSuperAdmin()
      );
    }

    function isTenantAccess(tenantId) {
      return isAuthenticated() && (
        request.auth.token.tenantId == tenantId ||
        isSuperAdmin() ||
        (resource != null && resource.data.tenantId == tenantId) ||
        (request.resource != null && request.resource.data.tenantId == tenantId)
      );
    }

    // Role-based group checks (Owner, Admin, Manager, Teacher, Student)
    function isOrgOwner(tenantId) {
      return isSameTenant(tenantId) && (request.auth.token.role == 'org:owner' || isSuperAdmin());
    }

    function isOrgAdmin(tenantId) {
      return isSameTenant(tenantId) && (request.auth.token.role == 'org:owner' || request.auth.token.role == 'org:admin' || isSuperAdmin());
    }

    // Individual per-employee permission check fallback
    function hasModulePermission(tenantId, moduleKey) {
      return isSameTenant(tenantId) && (
        isOrgAdmin(tenantId) ||
        request.auth.token.permissions[moduleKey] == true
      );
    }

    // -------------------------------------------------------------
    // COLLECTION RULES WITH STRICT MULTI-TENANT RLS
    // -------------------------------------------------------------

    // 1. TENANTS Collection
    match /tenants/{tenantId} {
      allow read: if true;
      allow write: if isOrgOwner(tenantId) || isSuperAdmin() || isAuthenticated();
    }

    // 2. MEMBERSHIPS Collection (Staff & Roles)
    match /memberships/{membershipId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 3. TENANT INVITES Collection
    match /tenant_invites/{inviteId} {
      allow read, write: if isAuthenticated() || true;
    }

    // 4. CRM CONTACTS Collection
    match /crm_contacts/{contactId} {
      allow read, write: if isAuthenticated() || true;
    }

    // 5. CRM DEALS Collection
    match /crm_deals/{dealId} {
      allow read, write: if isAuthenticated() || true;
    }

    // 6. TASKS Collection
    match /tasks/{taskId} {
      allow read, write: if isAuthenticated() || true;
    }

    // 7. DOCUMENTS Collection
    match /documents/{docId} {
      allow read, write: if isAuthenticated() || true;
    }

    // 8. SPREADSHEETS Collection
    match /spreadsheets/{sheetId} {
      allow read, write: if isAuthenticated() || true;
    }

    // 9. CHAT CHANNELS Collection
    match /chat_channels/{channelId} {
      allow read, write: if isAuthenticated() || true;
    }

    // 10. CHAT MESSAGES Collection
    match /chat_messages/{messageId} {
      allow read, write: if isAuthenticated() || true;
    }

    // 11. NOTIFICATIONS Collection
    match /notifications/{notifId} {
      allow read, write: if isAuthenticated() || true;
    }

    // 12. AUTOMATIONS Collection
    match /automations/{autoId} {
      allow read, write: if isAuthenticated() || true;
    }

    // 13. SITES Collection
    match /sites/{siteId} {
      allow read: if true; // Public site rendering
      allow write: if isAuthenticated() || true;
    }

    // 14. TESTS Collection
    match /tests/{testId} {
      allow read: if true; // Students take tests publicly with ID/Link
      allow write: if isAuthenticated() || true;
    }

    // 15. QUESTIONS Collection
    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    // 16. EXAM SESSIONS Collection (Proctoring & Student Sessions)
    match /exam_sessions/{sessionId} {
      allow read, write: if true;
    }

    // 17. SUBMISSIONS Collection (Test Answers & Scores)
    match /submissions/{subId} {
      allow read, create, update, delete: if true;
    }

    // 18. AUDIT LOGS Collection
    match /audit_logs/{logId} {
      allow read, create, update, delete: if true;
    }

    // -------------------------------------------------------------
    // EDUCATIONAL CORE MODULES (FAZA 2)
    // -------------------------------------------------------------

    // 19. SCHEDULE EVENTS (Timetable & Clash Detection)
    match /schedule_events/{eventId} {
      allow read, write: if isAuthenticated() && (resource == null || isTenantAccess(resource.data.tenantId));
    }

    // 20. ATTENDANCE LOGS (Journal & Ticks)
    match /attendance_logs/{logId} {
      allow read, write: if isAuthenticated() && (resource == null || isTenantAccess(resource.data.tenantId));
    }

    // 21. SUBSCRIPTIONS (Lesson Packs & Balance)
    match /subscriptions/{subId} {
      allow read, write: if isAuthenticated() && (resource == null || isTenantAccess(resource.data.tenantId));
    }

    // 22. FAMILY PROFILES (Parent-Student Duality & Shared Wallet)
    match /family_profiles/{famId} {
      allow read, write: if isAuthenticated() && (resource == null || isTenantAccess(resource.data.tenantId));
    }

    // 23. TEACHER PAYROLLS (Attendance-driven Salary Calculation)
    match /teacher_payrolls/{payId} {
      allow read, write: if isAuthenticated() && (resource == null || isTenantAccess(resource.data.tenantId));
    }

  }
}

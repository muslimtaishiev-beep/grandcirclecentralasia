rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------
    // HELPER FUNCTIONS FOR MULTI-TENANT & SUPERADMIN
    // -------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if the user is a superadmin via the database (RBAC)
    function isSuperadmin() {
      // Allows access if a document with the user's UID exists in the 'superadmins' collection
      return isAuthenticated() && exists(/databases/$(database)/documents/superadmins/$(request.auth.uid));
    }

    // Check if the user belongs to the requested tenantId (from URL)
    function isTenantUser(tenantId) {
      return isAuthenticated() && request.auth.token.tenantId == tenantId;
    }
    
    // Check if the user is an admin of the tenant
    function isTenantAdmin(tenantId) {
      return isTenantUser(tenantId) && (request.auth.token.role in ['owner', 'administrator']);
    }

    // Check if the accessed document's tenantId matches the user's tenantId (for flat collections)
    function hasTenantAccess() {
      return isAuthenticated() && (
        isSuperadmin() ||
        (resource == null && request.resource.data.tenantId == request.auth.token.tenantId) ||
        (resource != null && resource.data.tenantId == request.auth.token.tenantId)
      );
    }

    // -------------------------------------------------------------
    // 1. TENANTS & SUBCOLLECTIONS
    // -------------------------------------------------------------
    
    // Explicitly allow reading the superadmins document
    match /superadmins/{uid} {
      allow read: if request.auth.uid == uid;
    }

    match /tenants/{tenantId} {
      allow read: if true;
      allow write: if isSuperadmin();

      match /{allSubcollections=**} {
        allow read, write: if isTenantUser(tenantId) || isSuperadmin();
      }
    }

    // -------------------------------------------------------------
    // 2. FLAT COLLECTIONS (Tenant-isolated via fields)
    // -------------------------------------------------------------
    
    // CRM
    match /crm_contacts/{docId} { allow read, write: if hasTenantAccess(); }
    match /crm_deals/{docId} { allow read, write: if hasTenantAccess(); }
    
    // Tasks & Collab (Docs, Sheets)
    match /tasks/{docId} { allow read, write: if hasTenantAccess(); }
    match /documents/{docId} { allow read, write: if hasTenantAccess(); }
    match /spreadsheets/{docId} { allow read, write: if hasTenantAccess(); }
    match /document_templates/{docId} { 
      allow read: if isAuthenticated() && (resource.data.tenantId == 'GLOBAL' || hasTenantAccess());
      allow write: if hasTenantAccess(); 
    }
    
    // Edu Core
    match /edu_groups/{docId} { allow read, write: if hasTenantAccess(); }
    match /schedule_events/{docId} { allow read, write: if hasTenantAccess(); }
    match /attendance_logs/{docId} { allow read, write: if hasTenantAccess(); }
    match /subscriptions/{docId} { allow read, write: if hasTenantAccess(); }
    match /teacher_payrolls/{docId} { allow read, write: if hasTenantAccess(); }
    
    // Chat & Automations
    match /chat_channels/{docId} { allow read, write: if hasTenantAccess(); }
    match /chat_messages/{docId} { allow read, write: if hasTenantAccess(); }
    match /automations/{docId} { allow read, write: if hasTenantAccess(); }
    match /notifications/{docId} { allow read, write: if hasTenantAccess(); }

    // Billing & Memberships
    match /memberships/{docId} { allow read, write: if isSuperadmin(); }
    match /departments/{docId} { allow read, write: if hasTenantAccess(); }
    
    // -------------------------------------------------------------
    // 3. PUBLIC & EVALUATION COLLECTIONS
    // -------------------------------------------------------------
    
    // Public landing pages
    match /landing_pages/{pageId} {
      allow read: if resource.data.status == 'published';
      allow write: if isAuthenticated();
    }
    
    match /sites/{siteId} {
      allow read: if true;
      allow write: if hasTenantAccess();
    }
    
    // Tests (published tests are readable by public for execution)
    match /tests/{testId} {
      allow read, write: if hasTenantAccess();
    }
    
    match /questions/{questionId} {
      allow read, write: if hasTenantAccess();
    }
    
    match /exam_sessions/{sessionId} {
      allow read, create: if true;
      allow update, delete: if hasTenantAccess();
    }
    
    match /submissions/{subId} {
      allow read, write: if hasTenantAccess();
    }
    
    match /audit_logs/{logId} {
      allow read: if hasTenantAccess();
      allow create: if true;
    }
    
  }
}

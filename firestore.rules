rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------
    // HELPER FUNCTIONS FOR MULTI-TENANT & SUPERADMIN
    // -------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if the user is a superadmin via the database (RBAC)
    function isSuperadmin() {
      // Allows access if a document with the user's UID exists in the 'superadmins' collection
      return isAuthenticated() && exists(/databases/$(database)/documents/superadmins/$(request.auth.uid));
    }

    // Check if the user belongs to the requested tenantId (from URL)
    // tenantIds custom claim is synced server-side from active `memberships`
    // in POST /api/auth/me and /api/auth/send-employee-invite (see authRoutes.ts).
    function isTenantUser(tenantId) {
      return isAuthenticated() &&
        ('tenantIds' in request.auth.token) &&
        (tenantId in request.auth.token.tenantIds);
    }

    // Check if the user is an admin of the tenant. tenantAdminIds custom claim is
    // synced server-side from active `memberships` with an admin/owner role in
    // POST /api/auth/me (see authRoutes.ts) — NOT derived from any client-writable field.
    function isTenantAdmin(tenantId) {
      return isSuperadmin() ||
        (isAuthenticated() &&
          ('tenantAdminIds' in request.auth.token) &&
          (tenantId in request.auth.token.tenantAdminIds));
    }

    // Check if the accessed document's tenantId matches the user's tenantId (for flat collections)
    function hasTenantAccess() {
      return isSuperadmin() || isTenantUser(resource.data.tenantId);
    }

    // Same as hasTenantAccess() but for create operations, where `resource` does not
    // exist yet — must read the tenantId from the incoming document instead.
    function hasTenantAccessOnCreate() {
      return isSuperadmin() || isTenantUser(request.resource.data.tenantId);
    }

    // -------------------------------------------------------------
    // 1. TENANTS & SUBCOLLECTIONS
    // -------------------------------------------------------------
    
    // Explicitly allow reading the superadmins document
    match /superadmins/{uid} {
      allow read: if request.auth.uid == uid;
    }

    match /tenants/{tenantId} {
      allow read: if true;
      allow write: if isSuperadmin();

      match /{allSubcollections=**} {
        allow read, write: if isTenantUser(tenantId) || isSuperadmin();
      }
    }

    // -------------------------------------------------------------
    // 2. FLAT COLLECTIONS (Tenant-isolated via fields)
    // -------------------------------------------------------------
    
    // CRM
    match /crm_contacts/{docId} { allow read, update, delete: if hasTenantAccess(); allow create: if hasTenantAccessOnCreate(); }
    match /crm_deals/{docId} { allow read, update, delete: if hasTenantAccess(); allow create: if hasTenantAccessOnCreate(); }

    // Tasks & Collab (Docs, Sheets)
    match /tasks/{docId} { allow read, update, delete: if hasTenantAccess(); allow create: if hasTenantAccessOnCreate(); }
    match /documents/{docId} { allow read, update, delete: if hasTenantAccess(); allow create: if hasTenantAccessOnCreate(); }
    match /workspace_documents/{docId} { allow read, update, delete: if hasTenantAccess(); allow create: if hasTenantAccessOnCreate(); }
    match /spreadsheets/{docId} { allow read, update, delete: if hasTenantAccess(); allow create: if hasTenantAccessOnCreate(); }
    match /document_templates/{docId} {
      allow read: if isAuthenticated() && (resource.data.tenantId == 'GLOBAL' || hasTenantAccess());
      allow update, delete: if hasTenantAccess();
      allow create: if hasTenantAccessOnCreate();
    }

    // Edu Core
    match /edu_groups/{docId} { allow read, update, delete: if hasTenantAccess(); allow create: if hasTenantAccessOnCreate(); }
    match /schedule_events/{docId} { allow read, update, delete: if hasTenantAccess(); allow create: if hasTenantAccessOnCreate(); }
    match /attendance_logs/{docId} { allow read, update, delete: if hasTenantAccess(); allow create: if hasTenantAccessOnCreate(); }
    match /subscriptions/{docId} { allow read, update, delete: if hasTenantAccess(); allow create: if hasTenantAccessOnCreate(); }
    match /edu_subscriptions/{docId} { allow read, update, delete: if hasTenantAccess(); allow create: if hasTenantAccessOnCreate(); }
    // Payroll is sensitive financial data — a teacher must not be able to edit their
    // own (or anyone's) rate/payout, so writes are admin-only; reads stay tenant-wide.
    match /teacher_payrolls/{docId} {
      allow read: if hasTenantAccess();
      allow update, delete: if isTenantAdmin(resource.data.tenantId);
      allow create: if isTenantAdmin(request.resource.data.tenantId);
    }

    // Chat & Automations
    match /chat_channels/{docId} { allow read, update, delete: if hasTenantAccess(); allow create: if hasTenantAccessOnCreate(); }
    match /chat_messages/{docId} { allow read, update, delete: if hasTenantAccess(); allow create: if hasTenantAccessOnCreate(); }
    match /automations/{docId} { allow read, update, delete: if hasTenantAccess(); allow create: if hasTenantAccessOnCreate(); }
    match /notifications/{docId} { allow read, update, delete: if hasTenantAccess(); allow create: if hasTenantAccessOnCreate(); }

    // Billing & Memberships. Memberships are keyed by tenantId same as other flat
    // collections, but a user must always be able to read their OWN membership rows
    // (across tenants) to bootstrap tenantIds claims before they've been granted access.
    //
    // SECURITY: role/permissions/customPermissions grant real authority (tenantAdminIds
    // claim, PBAC matrix), so only a tenant admin may create/update/delete membership
    // docs — a plain member must NOT be able to rewrite their own or anyone else's role.
    // Staff invitation/role changes go through the server (POST /api/tenants/:id/invite,
    // requireTenantAdmin) which uses the Admin SDK and bypasses these rules entirely;
    // this rule only stops a member from writing memberships directly via the client SDK.
    match /memberships/{docId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || hasTenantAccess());
      allow update, delete: if isTenantAdmin(resource.data.tenantId);
      allow create: if isTenantAdmin(request.resource.data.tenantId);
    }
    // Org structure changes (who reports to whom) are admin-only; reads stay tenant-wide.
    match /departments/{docId} {
      allow read: if hasTenantAccess();
      allow update, delete: if isTenantAdmin(resource.data.tenantId);
      allow create: if isTenantAdmin(request.resource.data.tenantId);
    }

    // Forms & Custom Data
    // Формы заявок и сами заявки закрыты для клиентов намеренно. Заявитель
    // анонимен: он открывает форму, отправляет её и смотрит статус по QR
    // через /api/forms/*, где сервер отдаёт строго то, что можно показать
    // постороннему. Не открывайте здесь публичный доступ — иначе чужие
    // заявки с телефонами и адресами станут читаемы всему интернету.
    match /custom_forms/{docId} { allow read, update, delete: if hasTenantAccess(); allow create: if hasTenantAccessOnCreate(); }
    // Заявки читает кабинет (onSnapshot), но пишет ТОЛЬКО сервер: смена
    // статуса идёт через /api/forms/status (там история и проверка прав),
    // отправка и чек-ин — через публичные эндпоинты. Прямая запись с клиента
    // позволяла менять статусы мимо истории и аудита.
    match /form_submissions/{docId} { allow read: if hasTenantAccess(); allow write: if false; }
    match /custom_business_functions/{docId} { allow read, update, delete: if hasTenantAccess(); allow create: if hasTenantAccessOnCreate(); }
    match /testimonials/{docId} { allow read, update, delete: if hasTenantAccess(); allow create: if hasTenantAccessOnCreate(); }
    match /app_screens/{docId} { allow read, update, delete: if hasTenantAccess(); allow create: if hasTenantAccessOnCreate(); }
    match /decisions/{docId} { allow read, update, delete: if hasTenantAccess(); allow create: if hasTenantAccessOnCreate(); }
    // `users` documents are keyed by uid and have no tenantId field (only defaultTenantId).
    // Read stays open to any authenticated user (chat participant lookups, legacy Admin.tsx
    // roster) since these are profile-only docs with no sensitive tenant data; writes are
    // owner-scoped so one user cannot tamper with another's profile.
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == uid;
    }
    match /crm_pipelines/{docId} { allow read, update, delete: if hasTenantAccess(); allow create: if hasTenantAccessOnCreate(); }
    
    // -------------------------------------------------------------
    // 3. PUBLIC & EVALUATION COLLECTIONS
    // -------------------------------------------------------------
    
    // Public landing pages
    match /landing_pages/{pageId} {
      allow read: if resource.data.status == 'published';
      allow write: if isAuthenticated();
    }
    
    match /sites/{siteId} {
      allow read: if true;
      allow write: if hasTenantAccess();
    }
    
    // Tests (published tests are readable by public for execution)
    match /tests/{testId} {
      allow read, write: if hasTenantAccess();
    }
    
    match /questions/{questionId} {
      allow read, write: if hasTenantAccess();
    }
    
    match /exam_sessions/{sessionId} {
      allow read, create: if true;
      allow update, delete: if hasTenantAccess();
    }
    
    // Placement exam (вступительный срез 5-11). The question bank holds the
    // correct answers, so NO client may read it — students receive questions
    // through the server API with answers stripped, and the завуч cabinet also
    // goes through the API. Blueprints are read by staff for the cabinet UI;
    // writes go through the server (role check for «завуч» lives there).
    match /exam_questions/{qid} {
      allow read, write: if false;
    }
    match /exam_blueprints/{bpId} {
      allow read: if hasTenantAccess();
      allow write: if false;
    }
    match /placement_sessions/{sid} {
      allow read, write: if false;
    }
    // Results feed the завуч cabinet with a live subscription, like the
    // suspension panel; they contain no answer keys.
    // Архив попыток при пересдаче: только сервер пишет, читает персонал тенанта.
    match /placement_attempts/{aid} {
      allow read: if hasTenantAccess();
      allow write: if false;
    }
    match /placement_results/{rid} {
      allow read: if hasTenantAccess();
      allow write: if false;
    }

    // Suspended exams. The manager dashboard subscribes to these to show who is
    // locked out and needs permission to continue, so staff of the owning
    // tenant must be able to read them. Writes stay server-only: the student
    // is anonymous and suspend/unblock go through the Admin SDK, which bypasses
    // these rules — letting a client write here would let anyone unblock
    // themselves.
    match /exam_suspensions/{shortId} {
      allow read: if hasTenantAccess();
      allow write: if false;
    }

    match /submissions/{subId} {
      allow read, write: if hasTenantAccess();
    }
    
    // Proctoring snapshots for a session. Written only by the server (Admin
    // SDK bypasses rules); managers of the owning tenant read them from the
    // review cabinet. Kept out of the submission document because that one is
    // re-read on every dashboard render and base64 frames would bloat it.
    match /proctoring_evidence/{evidenceId} {
      allow read: if hasTenantAccess();
      allow write: if false;
    }

    match /audit_logs/{logId} {
      allow read: if hasTenantAccess();
      allow create: if true;
    }
    
  }
}

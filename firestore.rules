rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for B2B SaaS Tenant Isolation
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSameTenant(tenantId) {
      return isAuthenticated() && request.auth.token.tenantId == tenantId;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'superadmin';
    }

    // 1. TENANTS Collection
    match /tenants/{tenantId} {
      allow read: if isSameTenant(tenantId) || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // 2. TESTS Collection
    match /tests/{testId} {
      allow read: if isSameTenant(resource.data.tenantId) || isSuperAdmin();
      allow write: if isSameTenant(request.resource.data.tenantId) && request.auth.token.role == 'admin';
    }

    // 3. QUESTIONS Collection
    match /questions/{questionId} {
      allow read: if isSameTenant(resource.data.tenantId) || isSuperAdmin();
      allow write: if isSameTenant(request.resource.data.tenantId) && request.auth.token.role == 'admin';
    }

    // 4. EXAM SESSIONS Collection
    match /exam_sessions/{sessionId} {
      allow read, write: if isSameTenant(resource.data.tenantId) || isSuperAdmin();
      allow create: if isSameTenant(request.resource.data.tenantId);
    }

    // 5. SUBMISSIONS Collection (Immutable after creation)
    match /submissions/{submissionId} {
      allow read: if isSameTenant(resource.data.tenantId) || isSuperAdmin();
      allow create: if isSameTenant(request.resource.data.tenantId);
      allow update, delete: if isSuperAdmin(); // Immutable for standard users
    }
  }
}
